---
interface Props { title: string; schema?: object; }
const { title, schema } = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0" />
		<title>{title}</title>
		<link rel="stylesheet" href="/styles/global.css" />
		{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
	</head>
	<body>
		<slot />
		<script is:inline>
			if ('scrollRestoration' in history) { history.scrollRestoration = 'manual'; }
			window.addEventListener('DOMContentLoaded', () => {
				document.querySelectorAll('.tab-btn').forEach(t => t.addEventListener('click', (e) => {
					const id = e.target.dataset.id;
					document.querySelectorAll('.tab-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + id));
				}));
				document.querySelectorAll('[data-close]').forEach(btn => btn.addEventListener('click', () => {
					const modal = document.getElementById(`modal-${btn.dataset.close}`);
					if(modal) modal.classList.remove('open');
				}));
			});
		</script>
	</body>
</html>
