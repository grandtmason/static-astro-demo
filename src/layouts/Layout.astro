---
interface Props {
	title: string;
	schema?: object;
}
const { title, schema } = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
		{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
		<style is:global>
			:root { --parchment: #F9F8F4; --ink: #2F2F2F; --gold: #B8860B; --muted: #7A7A7A; }
			body { margin: 0; padding: 0; background: var(--parchment); font-family: 'EB Garamond', Georgia, serif; color: var(--ink); }
			#sabr-portal { display: flex !important; flex-direction: column !important; height: 100vh !important; width: 100vw !important; overflow: hidden !important; }
			#content-wrap { flex: 1 !important; overflow-y: auto !important; width: 100% !important; padding-bottom: 60px !important; }
			.ds-grid { display: grid !important; grid-template-columns: 1fr 1fr !important; gap: 2rem !important; padding: 2rem !important; }
			.carousel-img { display: none !important; width: 100% !important; border-radius: 8px !important; }
			.carousel-img.active { display: block !important; }
			.tab-panel { display: none !important; }
			.tab-panel.active { display: block !important; }
			.ds-sec-lbl { font-size: 0.8rem !important; text-transform: uppercase !important; color: var(--muted) !important; margin: 0 !important; }
			.ds-val { font-size: 1.1rem !important; margin-top: 0.25rem !important; font-weight: 600 !important; }
			.top-bar { padding: 1rem !important; border-bottom: 1px solid #ccc !important; display: flex !important; align-items: center !important; }
		</style>
	</head>
	<body>
		<slot />
	</body>
</html>
