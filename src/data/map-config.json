// Replace your existing fetch block in NewMap.astro with this:
const fetchJson = async (url) => {
  const res = await fetch(url);
  const text = await res.text(); // Get raw text first
  try {
    return JSON.parse(text); // Try to parse
  } catch (e) {
    console.warn(`Could not load ${url} - Server returned:`, text.substring(0, 50));
    return null; // Return null if it's not JSON (like an HTML error page)
  }
};

const [topoData, farmData, mapConfig] = await Promise.all([
  fetchJson('/data/za-provinces.topojson'),
  fetchJson('/data/farms.json'),
  fetchJson('/data/map-config.json')
]);
