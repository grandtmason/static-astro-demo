---
import fs from 'fs';
import path from 'path';

interface Props {
  slug: string;
}
const { slug } = Astro.props;

const farmsPath = path.join(process.cwd(), 'public/data/farms.json');
const farmData = JSON.parse(fs.readFileSync(farmsPath, 'utf-8'));
---

<div id="map-root" data-slug={slug} data-farms={JSON.stringify(farmData)}>
  <svg id="map-svg" viewBox="0 0 800 700"></svg>
</div>

<script>
