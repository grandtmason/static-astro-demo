---
const { slug } = Astro.props;
---

<div id="map-root" data-slug={slug}>
  <div id="map-container" style="width: 100%; height: 500px; border: 1px solid #eee;">
    <svg id="map-svg" viewBox="0 0 800 700" preserveAspectRatio="xMidYMid meet" style="width: 100%; height: 100%;"></svg>
  </div>
</div>

<script>
  import { feature } from "topojson-client";
  import { geoPath, geoMercator } from "d3-geo";

  const initMap = async () => {
    try {
      const root = document.getElementById('map-root');
      const svg = document.getElementById('map-svg');
      if (!root || !svg) return;

      const slug = root.dataset.slug;
      
      // Helper to fetch and validate JSON
      const safeFetch = async (url: string) => {
        const response = await fetch(url);
        if (!response.ok) return null;
        
        const contentType = response.headers.get("content-type");
        if (!contentType || !contentType.includes("application/json")) {
          console.error(`Fetch error: Expected JSON from ${url} but got ${contentType}`);
          return null;
        }
        return response.json();
      };

      // FETCH WITH ABSOLUTE PATHS (starts with /)
      const [topoData, farmData, mapConfig] = await Promise.all([
        safeFetch('/data/za-provinces.topojson'),
        safeFetch('/data/farms.json'),
        safeFetch('/data/map-config.json')
      ]);

      if (!topoData || !topoData.objects) {
        console.warn("Map data missing or invalid.");
        return;
      }

      const objectKey = Object.keys(topoData.objects)[0];
      const provinceData = feature(topoData, topoData.objects[objectKey]);
      
      const projection = geoMercator().fitSize([800, 700], provinceData as any);
      const pathGenerator = geoPath().projection(projection);

      // Create provinces
      const provincesHtml = provinceData.features.map((feature: any) => `
        <path
          d="${pathGenerator(feature)}"
          fill="${mapConfig?.provinceColors?.[feature.properties.CODE] || "#f4f4f4"}"
          stroke="white"
          stroke-width="0.5"
        />
      `).join('');

      // Create markers
      const filteredFarms = Array.isArray(farmData) ? farmData.filter((f: any) => f.plant === slug) : [];
      const markersHtml = filteredFarms.map((farm: any) => {
        const coords = projection([farm.lng, farm.lat]);
        if (!coords) return '';
        const style = mapConfig?.markerStyles?.[farm.type] || { fill: "#D3D3D3", stroke: "#000" };
        return `<circle cx="${coords[0]}" cy="${coords[1]}" r="8" fill="${style.fill}" stroke="${style.stroke}" stroke-width="2" />`;
      }).join('');

      svg.innerHTML = provincesHtml + markersHtml;
    } catch (err) {
      console.error("Map initialization failed:", err);
    }
  };

  initMap();
</script>
