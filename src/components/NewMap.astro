---
// Updated to match your exact file names in src/data/
import topoData from '../data/za-provinces.topojson';
import farmData from '../data/plant_registry.json';
// Using common_names.json as your configuration reference
import mapConfig from '../data/common_names.json'; 

const { slug } = Astro.props;
---

<div 
  id="map-root" 
  data-slug={slug}
  data-topo={JSON.stringify(topoData)}
  data-farms={JSON.stringify(farmData)}
  data-config={JSON.stringify(mapConfig)}
>
  <div id="map-container" style="width: 100%; height: 500px; border: 1px solid #eee;">
    <svg id="map-svg" viewBox="0 0 800 700" preserveAspectRatio="xMidYMid meet" style="width: 100%; height: 100%;"></svg>
  </div>
</div>

<script>
  import { feature } from "topojson-client";
  import { geoPath, geoMercator } from "d3-geo";

  const initMap = () => {
    try {
      const root = document.getElementById('map-root');
      const svg = document.getElementById('map-svg');
      if (!root || !svg || !root.dataset.topo) return;

      const topoData = JSON.parse(root.dataset.topo);
      const farmData = JSON.parse(root.dataset.farms);
      const mapConfig = JSON.parse(root.dataset.config);
      const slug = root.dataset.slug;

      const objectKey = Object.keys(topoData.objects)[0];
      const provinceData = feature(topoData, topoData.objects[objectKey]);
      
      const projection = geoMercator().fitSize([800, 700], provinceData as any);
      const pathGenerator = geoPath().projection(projection);

      // Create provinces
      const provincesHtml = provinceData.features.map((feature: any) => `
        <path
          d="${pathGenerator(feature)}"
          fill="#f4f4f4"
          stroke="white"
          stroke-width="0.5"
        />
      `).join('');

      // Create markers
      const filteredFarms = Array.isArray(farmData) ? farmData.filter((f: any) => f.plant === slug) : [];
      const markersHtml = filteredFarms.map((farm: any) => {
        const coords = projection([farm.lng, farm.lat]);
        if (!coords) return '';
        return `<circle cx="${coords[0]}" cy="${coords[1]}" r="8" fill="#2ecc71" stroke="#fff" stroke-width="2" />`;
      }).join('');

      svg.innerHTML = provincesHtml + markersHtml;
    } catch (err) {
      console.error("Map initialization failed:", err);
    }
  };

  initMap();
</script>
