<script>
  import { feature } from "topojson-client";
  import { geoPath, geoMercator } from "d3-geo";

  const initMap = async () => {
    try {
      const root = document.getElementById('map-root');
      const svg = document.getElementById('map-svg');
      
      // Guard clause: ensure data attributes are populated before parsing
      if (!root || !svg || !root.dataset.farms) {
        console.warn("Map initialization: Missing data-farms attribute.");
        return;
      }

      // FIX: Use window.location.origin to force an absolute URL
      // This bypasses the Astro router interception
      const topoUrl = new URL('/data/za-provinces.topojson', window.location.origin).toString();
      const response = await fetch(topoUrl, { headers: { 'Accept': 'application/json' } });
      
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      const topoData = await response.json();
      
      const farmData = JSON.parse(root.dataset.farms);
      const slug = root.dataset.slug || "";
      
      // ... initialization logic (remaining code)
    } catch (err) {
      console.error("Map initialization failed:", err);
    }
  };
  initMap();
</script>
