---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
const allPlants = await getCollection('species');
const plants = allPlants
  .map(p => ({ 
    data: p.data, 
    slug: p.id.replace('/index', '').replace('.md', '') 
  }))
  .sort((a, b) => (a.data.name || "").localeCompare(b.data.name || ""));
---
<Layout title="South African Botanical Registry">
  <div class="hero">
    <div class="hero-title">South African Botanical Registry</div>
    <div class="hero-sub">The definitive reference for South Africa's botanical heritage</div>
  </div>
  <div class="registry">
    <div class="registry-title">{plants.length} Species Registered</div>
    <div class="plant-grid">
      {plants.map(plant => (
        <a href={`/species/${plant.slug}`} class="plant-card" data-slug={plant.slug} id={`card-${plant.slug}`}>
          {plant.data.image ? (
            <div class="plant-card-img">
              <img src={plant.data.image} alt={plant.data.name || "Plant species"} loading="lazy" />
            </div>
          ) : (
            <div class="plant-card-img-empty">
              <span>Image coming soon</span>
            </div>
          )}
          <div class="plant-card-body">
            <div class="plant-card-name">{plant.data.name || "Unnamed Species"}</div>
            <div class="plant-card-sci">{plant.data.scientific_name || "Unknown Scientific Name"}</div>
          </div>
        </a>
      ))}
    </div>
  </div>
  <div class="footer">
    <p>South African Botanical Registry · southafricanbotanical.org.za</p>
  </div>
</Layout>
<style>
  /* Local overrides for index-specific layout */
  .hero { text-align: center; padding: 60px 24px 50px; border-bottom: 1px solid var(--border, #E1DED8); }
  .hero-title { font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(2.4rem, 5vw, 4rem); font-weight: 300; font-style: italic; color: var(--green, #1A3A2A); line-height: 1.1; margin-bottom: 20px; }
  .hero-sub { font-family: sans-serif; font-size: 9px; letter-spacing: 3px; text-transform: uppercase; color: var(--muted, #7A7A7A); }
  .registry-title { font-family: sans-serif; font-size: 9px; letter-spacing: 3px; text-transform: uppercase; color: var(--muted, #7A7A7A); text-align: left; margin-bottom: 32px; }
  .registry { max-width: 1200px; margin: 0 auto; padding: 48px 40px 80px; }
  .plant-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .plant-card { text-decoration: none; display: flex; flex-direction: column; border: 1px solid rgba(184, 134, 11, 0.3); transition: box-shadow .2s, transform .2s; }
  .plant-card:hover { box-shadow: 0 4px 24px rgba(184,134,11,0.12); transform: translateY(-2px); border-color: rgba(184,134,11,0.7); }
  .plant-card-img { width: 100%; aspect-ratio: 1/1; overflow: hidden; }
  .plant-card-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .4s ease; }
  .plant-card:hover .plant-card-img img { transform: scale(1.03); }
  .plant-card-img-empty { width: 100%; aspect-ratio: 1/1; background: #1A3A2A; display: flex; align-items: center; justify-content: center; }
  .plant-card-img-empty span { font-family: sans-serif; font-size: 8px; letter-spacing: 2px; text-transform: uppercase; color: #9DB8A8; }
  .plant-card-body { padding: 14px 16px 16px; background: #F9F8F4; border-top: 1px solid rgba(184,134,11,0.2); }
  .plant-card-name { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.3rem; font-style: italic; font-weight: 300; color: #B8860B; line-height: 1; margin-bottom: 4px; }
  .plant-card-sci { font-family: sans-serif; font-size: 7px; letter-spacing: 2px; text-transform: uppercase; color: #7A7A7A; }
  .plant-card.sabr-highlight { animation: sabr-pulse 1.6s ease-out 1; }
  @keyframes sabr-pulse {
    0%   { box-shadow: 0 0 0 4px rgba(184,134,11,0.5); }
    100% { box-shadow: 0 0 0 4px rgba(184,134,11,0); }
  }

  @media (max-width: 768px) {
    .hero {
      position: fixed; top: 0; left: 0; right: 0; z-index: 400;
      background: var(--parch, #F9F8F4);
      padding: 22px 24px 18px;
      border-bottom: 2px solid var(--gold, #B8860B);
    }
    .hero-title { font-size: 1.7rem; margin-bottom: 10px; }
    .hero-sub { font-size: 9px; }
    .registry { padding: 110px 20px 100px; }
    .registry-title { margin-bottom: 32px; }
    .plant-grid { grid-template-columns: 1fr; }
  }
</style>

<script is:inline>
  (function () {
    const lastPlant = sessionStorage.getItem('sabr_last_plant');
    if (!lastPlant) return;
    sessionStorage.removeItem('sabr_last_plant');
    const card = document.getElementById(`card-${lastPlant}`);
    if (!card) return;
    card.scrollIntoView({ block: 'center', behavior: 'instant' });
    card.classList.add('sabr-highlight');
  })();
</script>
