---
export const prerender = true;
// ... your existing imports
import Layout from '../../layouts/Layout.astro';
import NewMap from '../../components/NewMap.astro';
import DataSheet from '../../components/DataSheet.astro';
import BuyerModal from '../../components/modals/BuyerModal.astro';
import SupplierModal from '../../components/modals/SupplierModal.astro';
import { getCollection } from 'astro:content';
import { generatePlantSchema } from '../../utils/seo';
import COMMON_NAMES from '../../data/common_names.json';

export async function getStaticPaths() {
  const allPlants = await getCollection('species');
  return allPlants.map(plant => ({
    params: { id: plant.id.replace('/index', '').replace('.md', '') },
    props: { plant },
  }));
}

const { plant } = Astro.props;
const d = plant.data;
const slug = plant.id.replace('/index', '').replace('.md', '');
const images = d.images || [];
const displayNames = COMMON_NAMES[slug] ? Object.entries(COMMON_NAMES[slug]) : [];
const FORMSPREE_CONNECT = "https://formspree.io/f/xaqzdwyj";
---

<Layout title={`${d.name} | SABR Registry`} schema={generatePlantSchema(d)}>
  <div class="portal">
    <div class="top-bar">
      <a href="/">←</a>
      <span>{d.name}</span>
    </div>
    <div class="content-wrap">
      <div class="tab-panel active">
        <div class="ds-grid">
          <div class="ds-left">
            {images.map((img: any) => <img src={img.src} alt={d.name} loading="lazy" />)}
            {displayNames.map(([l, n]) => <div><strong>{l}:</strong> {n}</div>)}
          </div>
          <div class="ds-right">
            <DataSheet plant={plant} />
            <NewMap slug={slug} />
          </div>
        </div>
      </div>
    </div>
  </div>
  <BuyerModal plant={plant} FORMSPREE_CONNECT={FORMSPREE_CONNECT} />
  <SupplierModal plant={plant} FORMSPREE_CONNECT={FORMSPREE_CONNECT} />
</Layout>
