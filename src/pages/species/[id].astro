---
import Layout from '../../layouts/Layout.astro';
import NewMap from '../../components/NewMap.astro';
import DataSheet from '../../components/DataSheet.astro';
import BuyerModal from '../../components/modals/BuyerModal.astro';
import SupplierModal from '../../components/modals/SupplierModal.astro';
import { getCollection } from 'astro:content';
import { generatePlantSchema } from '../../utils/seo';
import COMMON_NAMES from '../../data/common_names.json';

export async function getStaticPaths() {
  const allPlants = await getCollection('species');
  return allPlants.map(plant => {
    // FIX: use plant.slug (extension-stripped, e.g. 'acacia'),
    // not plant.id (raw filename, e.g. 'acacia.md')
    return {
      params: { id: plant.slug },
      props: { plant, slug: plant.slug },
    };
  });
}

const { plant, slug } = Astro.props;
const d = plant.data;
const images = d?.images || [];
const displayNames = (COMMON_NAMES as any)[slug] ? Object.entries((COMMON_NAMES as any)[slug]) : [];
const FORMSPREE_CONNECT = "https://formspree.io/f/xaqzdwyj";
---
<Layout title={`${d?.name || 'Plant'} | SABR Registry`} schema={generatePlantSchema(d)}>
  <div class="portal">
    {d ? (
      <div class="content-wrap">
        <div class="top-bar">
          <a href="/">←</a>
          <span>{d.name}</span>
        </div>
        <div class="tab-panel active" id={`panel-${slug}`}>
          <div class="ds-grid">
            <div class="ds-left">
              {images.map((img: any) => <img src={img.src} alt={d.name} loading="lazy" />)}
              {displayNames.map(([l, n]: [string, string]) => <div><strong>{l}:</strong> {n}</div>)}
            </div>
            <div class="ds-right">
              <DataSheet plant={plant} />
              <NewMap slug={slug} />
            </div>
          </div>
        </div>
      </div>
    ) : (
      <h1 style="color: red; padding: 2rem;">Error: Plant data not found for slug "{slug}"</h1>
    )}
  </div>
  <BuyerModal plant={plant} FORMSPREE_CONNECT={FORMSPREE_CONNECT} />
  <SupplierModal plant={plant} FORMSPREE_CONNECT={FORMSPREE_CONNECT} />
</Layout>
