---
// src/pages/species/[id].astro
export async function getStaticPaths() {
  // Add your logic to fetch all species IDs here
  // Returning sample data for demonstration
  return [
    { params: { id: 'acacia' } },
    { params: { id: 'african-ginger' } },
    { params: { id: 'aloe-ferox' } }
  ];
}

const { id } = Astro.params;
---
<html>
  <body>
    <h1>Species: {id}</h1>
    <p>This is the static page for {id}.</p>
  </body>
</html>
